# RevenueOS production settings (~/services/revenueos/.env on the server).

# --- host port the tunnel points at (127.0.0.1 only) ---
REVENUEOS_PORT=1039

# --- Postgres (container on the same compose network) ---
POSTGRES_PASSWORD=

# --- LLM (any OpenAI-compatible endpoint; defaults to Groq) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Hindsight memory ---
MEMORY_MODE=hindsight
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Keep production banks separate from local development.
HINDSIGHT_BANK_PREFIX=revenueos-prod
