# --- LLM (any OpenAI-compatible endpoint; defaults to Groq) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Hindsight memory ---
# hindsight = real Hindsight (required for the demo). mock = offline UI work only.
MEMORY_MODE=hindsight
# Self-hosted (docker): http://localhost:8888   |   Hindsight Cloud: your cloud API URL
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=revenueos
# Model Hindsight itself uses (npm run hindsight:up). Defaults to openai/gpt-oss-20b on Groq.
HINDSIGHT_LLM_MODEL=

# --- Postgres for structured CRM data ---
# Leave empty to use embedded Postgres (PGlite) stored in server/data/pg
DATABASE_URL=
PORT=4000
